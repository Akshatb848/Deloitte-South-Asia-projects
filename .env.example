# Copy to .env. All values below are read by backend/ (defaults shown).

# LLM (Ollama). If Ollama is unreachable the chatbot falls back to
# returning retrieved newsletter excerpts (retrieval-only mode).
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=mistral:7b-instruct

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_db

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
